# ── Solana RPC ────────────────────────────────────────────────────────────
RPC_URL=https://api.mainnet-beta.solana.com
RPC_WS_URL=wss://api.mainnet-beta.solana.com

# ── Wallet ────────────────────────────────────────────────────────────────
# base58-encoded secret key (NEVER commit the real value, NEVER print it)
PRIVATE_KEY=

# ── Capital allocation ───────────────────────────────────────────────────
INITIAL_LP_CAPITAL_SOL=1.2
MIN_GAS_RESERVE_SOL=0.1
ENABLE_AUTO_COMPOUND=true
MAX_CONCURRENT_POOLS=1

# ── Pool scanner filters ─────────────────────────────────────────────────
MIN_TVL_USD=50000
MAX_TVL_USD=1000000
MIN_24H_VOLUME_USD=200000
MIN_VOL_TVL_RATIO=3.0
POOL_SCAN_INTERVAL_MS=60000

# ── Memecoin screen (non-SOL side of the pool) ───────────────────────────
MAX_MEMECOIN_MARKET_CAP_USD=50000000
MIN_TOKEN_HOLDERS=300
REQUIRE_FREEZE_AUTHORITY_DISABLED=true
REQUIRE_MINT_AUTHORITY_DISABLED=true
MIN_BIN_STEP=15
MIN_POOL_AGE_HOURS=2

# ── Trend filter (feature/trend-aware-entry) ─────────────────────────────
# Prefer tokens not actively dumping over 6h instead of a high-volume token
# mid-downtrend. -5 (not 0) so merely-flat tokens don't get excluded too.
REQUIRE_UPTREND=true
MIN_PRICE_CHANGE_6H_PCT=-5
# 1h and 5m volume must be >= this fraction of the pool's own 24h average
# pace, or it's flagged as "24h number looks fine but dead right now".
MIN_RECENT_ACTIVITY_RATIO=0.15

# ── Position sizing ──────────────────────────────────────────────────────
# Bin radius is DERIVED per-pool from bin_step to hit this target ± price
# coverage (a fixed bin-count radius covers very different % ranges across
# pools with different bin_step). See src/logic/binRange.ts.
TARGET_RANGE_PCT=15
MIN_BIN_RADIUS=5
MAX_BIN_RADIUS=50

# ── Risk management ──────────────────────────────────────────────────────
STOP_LOSS_PCT=25
MAX_REBALANCE_PER_HOUR=3
REBALANCE_COOLDOWN_MS=300000
VOLUME_DROP_HARD_EXIT_PCT=60
BLACKLIST_DURATION_MS=21600000
# Short cooldown on LEFT_POOL/LEAVE_POOL exits (pool failed re-screen, not a
# violation) so it isn't re-entered the very next tick — see riskManager.ts.
LEFT_POOL_COOLDOWN_MS=1200000
# Force a compound cycle after this many minutes out-of-range while already
# in profit, instead of sitting idle waiting on fees that stopped accruing.
MAX_IDLE_OUT_OF_RANGE_MINUTES=10

# ── Swap / gas ────────────────────────────────────────────────────────────
SLIPPAGE_BPS=100
JUPITER_API_BASE_URL=https://quote-api.jup.ag

# ── Logging ───────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_DIR=./logs
